---
// Osaki — Japanese Sushi Restaurant
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <title>Osaki — Ristorante Giapponese di Sushi</title>
  <meta name="description" content="Un'autentica esperienza di sushi giapponese a Milano. Omakase, ingredienti stagionali freschi, atmosfera esclusiva." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg:        #0A0A0A;
      --bg-2:      #111111;
      --bg-card:   #141414;
      --gold:      #C9A84C;
      --gold-2:    #E3C47A;
      --gold-dim:  rgba(201,168,76,0.12);
      --cream:     #F0EBE1;
      --muted:     #7A6D5E;
      --border:    rgba(201,168,76,0.15);
      --serif:     'Noto Serif JP', serif;
      --sans:      'Noto Sans JP', sans-serif;
      --ease:      cubic-bezier(0.4,0,0.2,1);
    }
    *,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body {
      background:var(--bg);
      color:var(--cream);
      font-family:var(--sans);
      font-weight:300;
      line-height:1.75;
      overflow-x:hidden;
    }
    h1,h2,h3,h4 { font-family:var(--serif); font-weight:500; }
    a { color:inherit; text-decoration:none; }
    ul { list-style:none; }
    img { display:block; max-width:100%; }
    button { cursor:pointer; font-family:var(--sans); }

    /* ── ANIMATIONS ─────────────────────────────── */
    @keyframes fadeInUp {
      from { opacity:0; transform:translateY(28px); }
      to   { opacity:1; transform:translateY(0); }
    }
    @keyframes fadeIn {
      from { opacity:0; }
      to   { opacity:1; }
    }
    @keyframes expandX {
      from { transform:scaleX(0); }
      to   { transform:scaleX(1); }
    }
    @keyframes float {
      0%,100% { transform:translateY(0); }
      50%      { transform:translateY(-12px); }
    }
    @keyframes scrollBounce {
      0%,100% { transform:translateY(0); opacity:1; }
      50%      { transform:translateY(8px); opacity:.4; }
    }
    @keyframes goldShimmer {
      0%   { background-position:200% center; }
      100% { background-position:-200% center; }
    }

    .animate-on-scroll {
      opacity:0;
      transform:translateY(32px);
      transition:opacity .7s var(--ease), transform .7s var(--ease);
    }
    .animate-on-scroll.visible {
      opacity:1;
      transform:translateY(0);
    }
    .animate-delay-1 { transition-delay:.1s; }
    .animate-delay-2 { transition-delay:.2s; }
    .animate-delay-3 { transition-delay:.3s; }
    .animate-delay-4 { transition-delay:.4s; }

    /* ── UTILITIES ───────────────────────────────── */
    .section-label {
      display:inline-flex;
      align-items:center;
      gap:.75rem;
      font-size:.7rem;
      letter-spacing:.35em;
      text-transform:uppercase;
      color:var(--gold);
      margin-bottom:1.25rem;
    }
    .section-label::before {
      content:'';
      display:block;
      width:32px;
      height:1px;
      background:var(--gold);
    }
    .section-title {
      font-size:clamp(2rem,4vw,3rem);
      color:var(--cream);
      line-height:1.2;
      margin-bottom:1.25rem;
    }
    .section-sub {
      font-size:.95rem;
      color:var(--muted);
      max-width:520px;
      line-height:1.8;
    }
    .btn-primary {
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.85rem 2rem;
      background:var(--gold);
      color:#0A0A0A;
      font-family:var(--sans);
      font-size:.8rem;
      font-weight:500;
      letter-spacing:.12em;
      text-transform:uppercase;
      border:none;
      transition:background .25s var(--ease), transform .2s var(--ease);
      cursor:pointer;
    }
    .btn-primary:hover {
      background:var(--gold-2);
      transform:translateY(-2px);
    }
    .btn-secondary {
      display:inline-flex;
      align-items:center;
      gap:.5rem;
      padding:.85rem 2rem;
      background:transparent;
      color:var(--cream);
      font-family:var(--sans);
      font-size:.8rem;
      font-weight:400;
      letter-spacing:.12em;
      text-transform:uppercase;
      border:1px solid rgba(240,235,225,.25);
      transition:border-color .25s var(--ease), color .25s var(--ease), transform .2s var(--ease);
      cursor:pointer;
    }
    .btn-secondary:hover {
      border-color:var(--gold);
      color:var(--gold);
      transform:translateY(-2px);
    }

    /* ── NAVBAR ──────────────────────────────────── */
    #navbar {
      position:fixed;
      top:0; left:0; right:0;
      z-index:100;
      padding:1.5rem 2.5rem;
      transition:background .4s var(--ease), padding .4s var(--ease), box-shadow .4s var(--ease);
    }
    #navbar.scrolled {
      background:rgba(10,10,10,.92);
      backdrop-filter:blur(16px);
      -webkit-backdrop-filter:blur(16px);
      padding:1rem 2.5rem;
      box-shadow:0 1px 0 var(--border);
    }
    .nav-inner {
      max-width:1200px;
      margin:0 auto;
      display:flex;
      align-items:center;
      justify-content:space-between;
    }
    .nav-logo {
      display:flex;
      flex-direction:column;
      line-height:1;
      cursor:pointer;
    }
    .logo-en {
      font-family:var(--serif);
      font-size:1.4rem;
      font-weight:600;
      letter-spacing:.2em;
      color:var(--cream);
    }
    .logo-jp {
      font-family:var(--serif);
      font-size:.65rem;
      letter-spacing:.3em;
      color:var(--gold);
      margin-top:2px;
    }
    .nav-links {
      display:flex;
      align-items:center;
      gap:2.5rem;
    }
    .nav-links a {
      font-size:.78rem;
      letter-spacing:.12em;
      text-transform:uppercase;
      color:var(--muted);
      transition:color .25s var(--ease);
    }
    .nav-links a:hover { color:var(--cream); }
    .nav-reserve {
      font-size:.78rem;
      letter-spacing:.12em;
      text-transform:uppercase;
      padding:.6rem 1.4rem;
      border:1px solid var(--gold);
      color:var(--gold) !important;
      transition:background .25s var(--ease), color .25s var(--ease) !important;
    }
    .nav-reserve:hover {
      background:var(--gold) !important;
      color:#0A0A0A !important;
    }
    .nav-burger {
      display:none;
      flex-direction:column;
      gap:5px;
      background:none;
      border:none;
      padding:.25rem;
    }
    .nav-burger span {
      display:block;
      width:22px;
      height:1px;
      background:var(--cream);
      transition:transform .3s var(--ease), opacity .3s var(--ease);
    }
    .nav-mobile {
      display:none;
      position:fixed;
      inset:0;
      background:rgba(10,10,10,.98);
      z-index:99;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      gap:2.5rem;
    }
    .nav-mobile.open { display:flex; }
    .nav-mobile a {
      font-family:var(--serif);
      font-size:1.8rem;
      color:var(--cream);
      letter-spacing:.1em;
    }
    .nav-mobile a:hover { color:var(--gold); }
    .nav-mobile-close {
      position:absolute;
      top:1.5rem; right:2rem;
      background:none;
      border:none;
      color:var(--muted);
      font-size:1.5rem;
      line-height:1;
    }

    /* ── HERO ────────────────────────────────────── */
    #hero {
      height:100vh;
      min-height:600px;
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      overflow:hidden;
    }
    .hero-bg {
      position:absolute;
      inset:0;
      background:
        radial-gradient(ellipse 90% 60% at 50% 40%, rgba(201,168,76,.05) 0%, transparent 70%),
        linear-gradient(180deg,#0A0A0A 0%,#0E0D0B 100%);
    }
    .hero-kanji {
      position:absolute;
      font-family:var(--serif);
      font-size:min(55vw,52vh);
      font-weight:700;
      color:rgba(201,168,76,.028);
      user-select:none;
      pointer-events:none;
      line-height:1;
      top:50%;
      left:50%;
      transform:translate(-50%,-50%);
      animation:float 8s ease-in-out infinite;
    }
    .hero-lines {
      position:absolute;
      inset:0;
      overflow:hidden;
      pointer-events:none;
    }
    .hero-line-h {
      position:absolute;
      left:0; right:0;
      height:1px;
      background:linear-gradient(90deg,transparent,rgba(201,168,76,.08),transparent);
    }
    .hero-line-h:nth-child(1) { top:25%; }
    .hero-line-h:nth-child(2) { top:75%; }
    .hero-content {
      position:relative;
      z-index:2;
      padding:0 1.5rem;
    }
    .hero-sup {
      display:block;
      font-size:.7rem;
      letter-spacing:.45em;
      text-transform:uppercase;
      color:var(--gold);
      margin-bottom:1.75rem;
      opacity:0;
      animation:fadeInUp .9s .2s var(--ease) forwards;
    }
    .hero-title {
      font-family:var(--serif);
      font-size:clamp(5.5rem,16vw,13rem);
      font-weight:400;
      letter-spacing:.18em;
      line-height:1;
      color:var(--cream);
      margin-bottom:1.5rem;
      opacity:0;
      animation:fadeInUp .9s .45s var(--ease) forwards;
    }
    .hero-tagline {
      font-size:clamp(.85rem,1.5vw,1rem);
      font-weight:300;
      color:var(--muted);
      letter-spacing:.08em;
      margin-bottom:3rem;
      opacity:0;
      animation:fadeInUp .9s .65s var(--ease) forwards;
    }
    .hero-divider {
      width:60px;
      height:1px;
      background:var(--gold);
      margin:0 auto 3rem;
      transform-origin:center;
      opacity:0;
      animation:expandX .8s .85s var(--ease) forwards, fadeIn .8s .85s var(--ease) forwards;
    }
    .hero-actions {
      display:flex;
      gap:1rem;
      justify-content:center;
      flex-wrap:wrap;
      opacity:0;
      animation:fadeInUp .9s 1s var(--ease) forwards;
    }
    .hero-scroll {
      position:absolute;
      bottom:2.5rem;
      left:50%;
      transform:translateX(-50%);
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:.5rem;
      opacity:0;
      animation:fadeIn 1s 1.4s var(--ease) forwards;
    }
    .hero-scroll span {
      font-size:.6rem;
      letter-spacing:.35em;
      text-transform:uppercase;
      color:var(--muted);
    }
    .scroll-arrow {
      width:1px;
      height:36px;
      background:linear-gradient(180deg,var(--gold),transparent);
      animation:scrollBounce 2s ease-in-out infinite;
    }

    /* ── PHILOSOPHY ──────────────────────────────── */
    #philosophy {
      padding:7rem 2.5rem;
      background:var(--bg-2);
      position:relative;
      overflow:hidden;
    }
    .philosophy-inner {
      max-width:1100px;
      margin:0 auto;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:6rem;
      align-items:center;
    }
    .philosophy-kanji-art {
      font-family:var(--serif);
      font-size:clamp(6rem,12vw,10rem);
      font-weight:700;
      color:rgba(201,168,76,.15);
      line-height:1;
      text-align:center;
      animation:float 6s ease-in-out infinite;
    }
    .philosophy-kanji-label {
      text-align:center;
      font-size:.65rem;
      letter-spacing:.3em;
      text-transform:uppercase;
      color:var(--gold);
      margin-top:.5rem;
    }
    .philosophy-text .section-sub {
      max-width:100%;
      margin-bottom:1.5rem;
    }
    .philosophy-quote {
      border-left:2px solid var(--gold);
      padding:.75rem 1.25rem;
      font-family:var(--serif);
      font-size:1.05rem;
      color:var(--muted);
      font-style:italic;
      margin-top:2rem;
    }

    /* ── SIGNATURE DISHES ───────────────────────── */
    #signature {
      padding:7rem 2.5rem;
      background:var(--bg);
    }
    .signature-header {
      max-width:1100px;
      margin:0 auto 4rem;
    }
    .dishes-grid {
      max-width:1100px;
      margin:0 auto;
      display:grid;
      grid-template-columns:repeat(4,1fr);
      gap:1.5rem;
    }
    .dish-card {
      background:var(--bg-card);
      border:1px solid var(--border);
      overflow:hidden;
      cursor:pointer;
      transition:border-color .3s var(--ease), transform .3s var(--ease);
    }
    .dish-card:hover {
      border-color:rgba(201,168,76,.4);
      transform:translateY(-6px);
    }
    .dish-img {
      height:220px;
      position:relative;
      overflow:hidden;
      display:flex;
      align-items:center;
      justify-content:center;
    }
    .dish-kanji {
      font-family:var(--serif);
      font-size:5rem;
      font-weight:700;
      color:rgba(240,235,225,.06);
      transition:color .3s var(--ease);
      user-select:none;
    }
    .dish-card:hover .dish-kanji { color:rgba(201,168,76,.12); }
    .dish-tag {
      position:absolute;
      top:.75rem; left:.75rem;
      font-size:.6rem;
      letter-spacing:.25em;
      text-transform:uppercase;
      color:var(--gold);
      background:rgba(201,168,76,.1);
      padding:.3rem .7rem;
    }
    .dish-info {
      padding:1.25rem;
    }
    .dish-name {
      font-family:var(--serif);
      font-size:1.1rem;
      color:var(--cream);
      margin-bottom:.3rem;
    }
    .dish-desc {
      font-size:.8rem;
      color:var(--muted);
      line-height:1.6;
      margin-bottom:.75rem;
    }
    .dish-price {
      font-size:.85rem;
      color:var(--gold);
      letter-spacing:.05em;
    }
    /* Dish backgrounds */
    .dish-toro   .dish-img { background:linear-gradient(135deg,#160808,#2d1010,#180a0a); }
    .dish-uni    .dish-img { background:linear-gradient(135deg,#0e1510,#1a2f1a,#0c1a0e); }
    .dish-dragon .dish-img { background:linear-gradient(135deg,#0d1508,#1e3014,#0c1a08); }
    .dish-wagyu  .dish-img { background:linear-gradient(135deg,#150e05,#2e200a,#180e06); }

    /* ── OMAKASE ─────────────────────────────────── */
    #omakase {
      padding:8rem 2.5rem;
      background:var(--bg-2);
      position:relative;
      overflow:hidden;
      text-align:center;
    }
    .omakase-bg-kanji {
      position:absolute;
      inset:0;
      display:flex;
      align-items:center;
      justify-content:center;
      font-family:var(--serif);
      font-size:40vw;
      font-weight:700;
      color:rgba(201,168,76,.02);
      pointer-events:none;
      user-select:none;
      line-height:1;
    }
    .omakase-inner {
      position:relative;
      z-index:1;
      max-width:700px;
      margin:0 auto;
    }
    .omakase-inner .section-sub {
      max-width:100%;
      margin:0 auto 1.5rem;
      text-align:center;
    }
    .omakase-price {
      display:inline-flex;
      flex-direction:column;
      align-items:center;
      gap:.25rem;
      margin:2rem 0;
      padding:1.5rem 3rem;
      border:1px solid var(--border);
    }
    .omakase-price-label {
      font-size:.65rem;
      letter-spacing:.35em;
      text-transform:uppercase;
      color:var(--muted);
    }
    .omakase-price-value {
      font-family:var(--serif);
      font-size:2.5rem;
      color:var(--gold);
      font-weight:500;
    }
    .omakase-price-note {
      font-size:.75rem;
      color:var(--muted);
    }
    .omakase-features {
      display:flex;
      justify-content:center;
      gap:3rem;
      margin-bottom:2.5rem;
      flex-wrap:wrap;
    }
    .omakase-feat {
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:.5rem;
    }
    .omakase-feat-icon {
      width:40px; height:40px;
      border:1px solid var(--border);
      display:flex;
      align-items:center;
      justify-content:center;
      color:var(--gold);
    }
    .omakase-feat-icon svg { width:18px; height:18px; }
    .omakase-feat-text {
      font-size:.72rem;
      letter-spacing:.08em;
      color:var(--muted);
      text-align:center;
    }

    /* ── MENU ────────────────────────────────────── */
    #menu {
      padding:7rem 2.5rem;
      background:var(--bg);
    }
    .menu-inner {
      max-width:900px;
      margin:0 auto;
    }
    .menu-header { margin-bottom:3.5rem; }
    .menu-tabs {
      display:flex;
      gap:0;
      border-bottom:1px solid var(--border);
      margin-bottom:3rem;
    }
    .menu-tab {
      padding:.75rem 1.75rem;
      background:none;
      border:none;
      color:var(--muted);
      font-family:var(--sans);
      font-size:.78rem;
      letter-spacing:.15em;
      text-transform:uppercase;
      cursor:pointer;
      border-bottom:2px solid transparent;
      margin-bottom:-1px;
      transition:color .25s var(--ease), border-color .25s var(--ease);
    }
    .menu-tab.active {
      color:var(--gold);
      border-bottom-color:var(--gold);
    }
    .menu-tab:hover { color:var(--cream); }
    .menu-panel { display:none; }
    .menu-panel.active { display:block; }
    .menu-items {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:1.5rem 3rem;
    }
    .menu-item {
      display:flex;
      justify-content:space-between;
      align-items:baseline;
      gap:1rem;
      padding-bottom:1.25rem;
      border-bottom:1px solid rgba(240,235,225,.05);
    }
    .menu-item-left {}
    .menu-item-name {
      font-family:var(--serif);
      font-size:1rem;
      color:var(--cream);
      margin-bottom:.2rem;
    }
    .menu-item-desc {
      font-size:.75rem;
      color:var(--muted);
    }
    .menu-item-price {
      font-size:.9rem;
      color:var(--gold);
      white-space:nowrap;
      flex-shrink:0;
    }

    /* ── RESERVATION ─────────────────────────────── */
    #reservation {
      padding:7rem 2.5rem;
      background:var(--bg-2);
    }
    .reservation-inner {
      max-width:1100px;
      margin:0 auto;
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:6rem;
      align-items:start;
    }
    .res-info-title {
      font-family:var(--serif);
      font-size:clamp(2rem,4vw,3rem);
      margin-bottom:1rem;
    }
    .res-info-sub {
      font-size:.9rem;
      color:var(--muted);
      margin-bottom:2.5rem;
      line-height:1.8;
    }
    .res-detail {
      display:flex;
      flex-direction:column;
      gap:1rem;
    }
    .res-detail-item {
      display:flex;
      flex-direction:column;
      gap:.15rem;
    }
    .res-detail-label {
      font-size:.65rem;
      letter-spacing:.3em;
      text-transform:uppercase;
      color:var(--gold);
    }
    .res-detail-value {
      font-size:.9rem;
      color:var(--cream);
    }
    .res-form {
      display:flex;
      flex-direction:column;
      gap:1.25rem;
    }
    .form-row {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:1.25rem;
    }
    .form-group {
      display:flex;
      flex-direction:column;
      gap:.4rem;
    }
    .form-label {
      font-size:.65rem;
      letter-spacing:.25em;
      text-transform:uppercase;
      color:var(--muted);
    }
    .form-input, .form-select, .form-textarea {
      background:rgba(240,235,225,.04);
      border:1px solid var(--border);
      color:var(--cream);
      font-family:var(--sans);
      font-size:.9rem;
      font-weight:300;
      padding:.85rem 1rem;
      outline:none;
      transition:border-color .25s var(--ease), background .25s var(--ease);
      width:100%;
    }
    .form-input::placeholder, .form-textarea::placeholder { color:var(--muted); }
    .form-input:focus, .form-select:focus, .form-textarea:focus {
      border-color:var(--gold);
      background:rgba(201,168,76,.04);
    }
    .form-select { cursor:pointer; }
    .form-select option { background:#111; color:var(--cream); }
    .form-textarea { resize:vertical; min-height:100px; }
    .form-submit {
      width:100%;
      padding:1rem;
      margin-top:.5rem;
    }

    /* ── FOOTER ──────────────────────────────────── */
    footer {
      background:#080808;
      border-top:1px solid var(--border);
      padding:4rem 2.5rem 2.5rem;
    }
    .footer-inner {
      max-width:1100px;
      margin:0 auto;
    }
    .footer-top {
      display:grid;
      grid-template-columns:2fr 1fr 1fr;
      gap:4rem;
      margin-bottom:3.5rem;
    }
    .footer-brand {}
    .footer-logo-en {
      font-family:var(--serif);
      font-size:1.6rem;
      letter-spacing:.2em;
      color:var(--cream);
    }
    .footer-logo-jp {

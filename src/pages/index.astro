// ── TORII draw animation
(function(){
  const paths = document.querySelectorAll('.torii-path');
  const svg = document.getElementById('toriiSvg');
  const label = document.getElementById('toriiLabel');
  paths.forEach(p => {
    try {
      const len = p.getTotalLength ? p.getTotalLength() : 800;
      p.style.strokeDasharray = len;
      p.style.strokeDashoffset = len;
    } catch(err) {
      p.style.strokeDasharray = 800;
      p.style.strokeDashoffset = 800;
    }
  });
  let drawn = false;
  const tObs = new IntersectionObserver(([entry]) => {
    if(entry.isIntersecting && !drawn){
      drawn = true;
      const order = ['tpKasagi','tpCapL','tpCapR','tpNuki','tpPilL','tpPilR','tpDL','tpDR'];
      order.forEach((id, i) => {
        const el = document.getElementById(id);
        if(!el) return;
        setTimeout(() => {
          el.style.transition = `stroke-dashoffset ${id.startsWith('tpPil') ? 1000 : 700}ms cubic-bezier(0.4,0,0.2,1)`;
          el.style.strokeDashoffset = '0';
        }, i * 280);
      });
      setTimeout(() => {
        svg.classList.add('glowing');
        label.classList.add('show');
        spawnSakura();
      }, order.length * 280 + 1100);
      tObs.disconnect();
    }
  }, {threshold:0.35});
  const sec = document.getElementById('torii');
  if(sec) tObs.observe(sec);

  function spawnSakura(){
    const layer = document.getElementById('sakuraLayer');
    if(!layer) return;
    const colors = ['#FFB7C5','#FFCCD5','#FFA0B4','#FFD6E0','#E8A0B0'];
    for(let i = 0; i < 22; i++){
      const p = document.createElement('div');
      p.className = 'spetal';
      const dur = (3.5 + Math.random() * 4.5).toFixed(1) + 's';
      const del = (Math.random() * 3.5).toFixed(1) + 's';
      const left = (Math.random() * 92 + 2).toFixed(1) + '%';
      const drift = ((Math.random() - 0.5) * 120).toFixed(0) + 'px';
      const col = colors[Math.floor(Math.random() * colors.length)];
      const rot = Math.floor(Math.random() * 360);
      p.style.cssText = `left:${left};--dur:${dur};--del:${del};--drift:${drift};`;
      p.innerHTML = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="transform:rotate(${rot}deg)">
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(0 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(72 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(144 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(216 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(288 20 20)"/>
        <circle cx="20" cy="20" r="3" fill="${col}"/>
      </svg>`;
      layer.appendChild(p);
    }
    setTimeout(spawnSakura, 5000);
  }
})();
</script>


        <div class="form-group">
          <label class="form-label" for="femail">Email</label>
          <input class="form-input" id="femail" type="email" placeholder="email@esempio.com" required />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="fdate">Data</label>
          <input class="form-input" id="fdate" type="date" required />
        </div>
        <div class="form-group">
          <label class="form-label" for="ftime">Ora</label>
          <select class="form-select" id="ftime" required>
            <option value="" disabled selected>Seleziona</option>
            <option>12:00</option><option>12:30</option><option>13:00</option><option>13:30</option>
            <option>18:30</option><option>19:00</option><option>19:30</option><option>20:00</option>
            <option>20:30</option><option>21:00</option><option>21:30</option>
          </select>
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label" for="fguests">Ospiti</label>
          <select class="form-select" id="fguests" required>
            <option value="" disabled selected>N. persone</option>
            <option>1</option><option>2</option><option>3</option><option>4</option>
            <option>5</option><option>6</option><option>7</option><option>8+</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label" for="ftype">Tipo</label>
          <select class="form-select" id="ftype">
            <option value="" disabled selected>Esperienza</option>
            <option>À la Carte</option>
            <option>Omakase (€120 p.p.)</option>
            <option>Occasione speciale</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label" for="fnote">Note speciali</label>
        <textarea class="form-textarea" id="fnote" placeholder="Allergie, richieste particolari, occasioni speciali..."></textarea>
      </div>
      <button type="submit" class="btn-primary form-submit">Invia Prenotazione</button>
    </form>
  </div>
</section>


---
// Osaki — Japanese Sushi Restaurant
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="favicon.svg" />
  <title>Osaki — Ristorante Giapponese di Sushi</title>
  <meta name="description" content="Un'autentica esperienza di sushi giapponese a Milano. Omakase, ingredienti stagionali freschi, atmosfera esclusiva." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:inline>
    :root {
      --bg:       #0A0A0A;
      --bg-2:     #111111;
      --bg-card:  #141414;
      --gold:     #C9A84C;
      --gold-2:   #E3C47A;
      --cream:    #F0EBE1;
      --muted:    #7A6D5E;
      --border:   rgba(201,168,76,0.15);
      --serif:    'Noto Serif JP', serif;
      --sans:     'Noto Sans JP', sans-serif;
      --ease:     cubic-bezier(0.4,0,0.2,1);
    }
    *,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { background:var(--bg); color:var(--cream); font-family:var(--sans); font-weight:300; line-height:1.75; overflow-x:hidden; }
    h1,h2,h3,h4 { font-family:var(--serif); font-weight:500; }
    a { color:inherit; text-decoration:none; }
    ul { list-style:none; }
    button { cursor:pointer; font-family:var(--sans); }

    /* ════════ KEYFRAMES ════════ */
    @keyframes fadeInUp { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fadeIn { from{opacity:0} to{opacity:1} }
    @keyframes expandX { from{transform:scaleX(0)} to{transform:scaleX(1)} }
    @keyframes scrollBounce { 0%,100%{transform:translateY(0);opacity:1} 50%{transform:translateY(8px);opacity:.4} }
    @keyframes floatRoll { 0%,100%{transform:translateY(0) rotate(var(--ra))} 50%{transform:translateY(-18px) rotate(var(--rb))} }
    @keyframes sakuraFall { 0%{transform:translateY(-60px) rotate(0) translateX(0);opacity:1} 80%{opacity:.8} 100%{transform:translateY(680px) rotate(720deg) translateX(var(--drift));opacity:0} }
    @keyframes toriiGlow { 0%,100%{filter:drop-shadow(0 0 6px rgba(201,168,76,.35))} 50%{filter:drop-shadow(0 0 22px rgba(201,168,76,.8))} }
    @keyframes shimmer { 0%{background-position:200% center} 100%{background-position:-200% center} }
    @keyframes letterIn { from{opacity:0;transform:translateY(50px) rotate(10deg) scale(.7)} to{opacity:1;transform:none} }
    @keyframes ensoSpin { from{transform:rotate(0)} to{transform:rotate(360deg)} }
    @keyframes dustFloat { 0%,100%{transform:translateY(0);opacity:0} 20%{opacity:.8} 50%{transform:translateY(-36px);opacity:.4} 80%{opacity:.7} }
    @keyframes marqueeX { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    @keyframes waveMove { from{transform:translateX(0)} to{transform:translateX(-50%)} }
    @keyframes koiSwim { 0%{transform:translate(0,0)} 25%{transform:translate(30vw,20px)} 50%{transform:translate(58vw,-14px)} 75%{transform:translate(85vw,12px)} 100%{transform:translate(118vw,0)} }
    @keyframes koiSwimBack { 0%{transform:translate(0,0)} 25%{transform:translate(-30vw,16px)} 50%{transform:translate(-58vw,-12px)} 75%{transform:translate(-85vw,14px)} 100%{transform:translate(-118vw,0)} }
    @keyframes tailWag { from{transform:rotate(-14deg)} to{transform:rotate(14deg)} }
    @keyframes finWag { from{transform:rotate(-10deg)} to{transform:rotate(12deg)} }
    @keyframes steamRise { 0%{transform:translateY(0) scaleX(1);opacity:0} 25%{opacity:.55} 100%{transform:translateY(-26px) scaleX(1.4);opacity:0} }
    @keyframes flameFlick { 0%,100%{transform:scaleY(1) scaleX(1)} 30%{transform:scaleY(1.18) scaleX(.92)} 60%{transform:scaleY(.88) scaleX(1.08)} 80%{transform:scaleY(1.1) scaleX(.95)} }
    @keyframes sparkleTwk { 0%,100%{opacity:0;transform:scale(.4)} 50%{opacity:1;transform:scale(1.1)} }
    @keyframes ikuraPulse { 0%,100%{transform:scale(1)} 50%{transform:scale(1.22)} }
    @keyframes sesameFall { 0%{transform:translateY(-8px) rotate(0);opacity:0} 15%{opacity:1} 90%{opacity:1} 100%{transform:translateY(95px) rotate(220deg);opacity:0} }
    @keyframes sliceBob { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }
    @keyframes dishFloat { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-5px)} }
    @keyframes sheenSweep { 0%{transform:translateX(-70px) rotate(18deg)} 60%,100%{transform:translateX(240px) rotate(18deg)} }
    @keyframes lanternSwing { from{transform:rotate(-5deg)} to{transform:rotate(5deg)} }
    @keyframes lanternGlow { 0%,100%{opacity:.25} 50%{opacity:.6} }
    @keyframes sojuRipple { 0%{transform:scale(.6);opacity:.7} 100%{transform:scale(1.6);opacity:0} }

    /* ════════ SCROLL ANIM BASE ════════ */
    .anim { opacity:0; transform:translateY(32px); transition:opacity .7s var(--ease),transform .7s var(--ease); }
    .anim.in { opacity:1; transform:none; }
    .d1{transition-delay:.1s} .d2{transition-delay:.2s} .d3{transition-delay:.3s} .d4{transition-delay:.4s}

    /* ════════ PROGRESS BAR ════════ */
    #progress { position:fixed; top:0; left:0; height:3px; width:0; z-index:200; background:linear-gradient(90deg,var(--gold),var(--gold-2)); box-shadow:0 0 12px rgba(201,168,76,.6); transition:width .1s linear; }

    /* ════════ UTILITIES ════════ */
    .lbl { display:inline-flex; align-items:center; gap:.75rem; font-size:.7rem; letter-spacing:.35em; text-transform:uppercase; color:var(--gold); margin-bottom:1.25rem; }
    .lbl::before { content:''; display:block; width:32px; height:1px; background:var(--gold); }
    .sec-title { font-size:clamp(2rem,4vw,3rem); color:var(--cream); line-height:1.2; margin-bottom:1.25rem; position:relative; display:inline-block; }
    .sec-title::after { content:''; position:absolute; left:0; bottom:-6px; width:100%; height:1px; background:linear-gradient(90deg,var(--gold),transparent); transform:scaleX(0); transform-origin:left; transition:transform .9s .35s var(--ease); }
    .anim.in .sec-title::after, .sec-title.anim.in::after { transform:scaleX(1); }
    .sec-sub { font-size:.95rem; color:var(--muted); max-width:520px; line-height:1.8; }
    .btn-p { position:relative; overflow:hidden; display:inline-flex; align-items:center; gap:.5rem; padding:.85rem 2rem; background:var(--gold); color:#0A0A0A; font-size:.8rem; font-weight:500; letter-spacing:.12em; text-transform:uppercase; border:none; transition:background .25s var(--ease),transform .2s var(--ease),box-shadow .25s; cursor:pointer; }
    .btn-p::after { content:''; position:absolute; top:-20%; left:0; width:40px; height:140%; background:rgba(255,255,255,.35); transform:translateX(-70px) rotate(18deg); }
    .btn-p:hover { background:var(--gold-2); transform:translateY(-2px); box-shadow:0 8px 24px rgba(201,168,76,.35); }
    .btn-p:hover::after { animation:sheenSweep .8s var(--ease); }
    .btn-s { display:inline-flex; align-items:center; gap:.5rem; padding:.85rem 2rem; background:transparent; color:var(--cream); font-size:.8rem; letter-spacing:.12em; text-transform:uppercase; border:1px solid rgba(240,235,225,.25); transition:border-color .25s,color .25s,transform .2s,box-shadow .25s; cursor:pointer; }
    .btn-s:hover { border-color:var(--gold); color:var(--gold); transform:translateY(-2px); box-shadow:0 8px 24px rgba(201,168,76,.15); }

    /* ════════ NAVBAR ════════ */
    #navbar { position:fixed; top:0; left:0; right:0; z-index:100; padding:1.5rem 2.5rem; transition:background .4s var(--ease),padding .4s var(--ease),box-shadow .4s var(--ease); }
    #navbar.scrolled { background:rgba(10,10,10,.93); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); padding:1rem 2.5rem; box-shadow:0 1px 0 var(--border); }
    .nav-inner { max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; }
    .nav-logo { display:flex; flex-direction:column; line-height:1; cursor:pointer; }
    .logo-en { font-family:var(--serif); font-size:1.4rem; font-weight:600; letter-spacing:.2em; color:var(--cream); }
    .logo-jp { font-family:var(--serif); font-size:.65rem; letter-spacing:.3em; color:var(--gold); margin-top:2px; }
    .nav-links { display:flex; align-items:center; gap:2.5rem; }
    .nav-links a { position:relative; font-size:.78rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); transition:color .25s; }
    .nav-links a:not(.nav-reserve)::after { content:''; position:absolute; left:0; bottom:-4px; width:100%; height:1px; background:var(--gold); transform:scaleX(0); transform-origin:right; transition:transform .3s var(--ease); }
    .nav-links a:hover { color:var(--cream); }
    .nav-links a:not(.nav-reserve):hover::after { transform:scaleX(1); transform-origin:left; }
    .nav-reserve { font-size:.78rem!important; padding:.6rem 1.4rem!important; border:1px solid var(--gold)!important; color:var(--gold)!important; transition:background .25s,color .25s!important; }
    .nav-reserve:hover { background:var(--gold)!important; color:#0A0A0A!important; }
    .nav-burger { display:none; flex-direction:column; gap:5px; background:none; border:none; padding:.25rem; }
    .nav-burger span { display:block; width:22px; height:1px; background:var(--cream); }
    .nav-mobile { display:none; position:fixed; inset:0; background:rgba(10,10,10,.98); z-index:99; flex-direction:column; align-items:center; justify-content:center; gap:2.5rem; }
    .nav-mobile.open { display:flex; }
    .nav-mobile a { font-family:var(--serif); font-size:1.8rem; color:var(--cream); letter-spacing:.1em; }
    .nav-mobile a:hover { color:var(--gold); }
    .nav-mc { position:absolute; top:1.5rem; right:2rem; background:none; border:none; color:var(--muted); font-size:1.5rem; line-height:1; }

    /* ════════ HERO ════════ */
    #hero { height:100vh; min-height:620px; position:relative; display:flex; align-items:center; justify-content:center; text-align:center; overflow:hidden; }
    .hero-bg { position:absolute; inset:0; background:radial-gradient(ellipse 90% 60% at 50% 40%,rgba(201,168,76,.055) 0%,transparent 70%),linear-gradient(180deg,#0A0A0A 0%,#0E0D0B 100%); }
    .hero-kanji { position:absolute; font-family:var(--serif); font-size:min(55vw,52vh); font-weight:700; color:rgba(201,168,76,.025); user-select:none; pointer-events:none; line-height:1; top:50%; left:50%; transform:translate(-50%,-50%); will-change:transform; }
    .hero-enso { position:absolute; top:50%; left:50%; width:min(540px,90vw); height:min(540px,90vw); margin:calc(min(540px,90vw)/-2) 0 0 calc(min(540px,90vw)/-2); pointer-events:none; opacity:0; animation:fadeIn 2s 1.2s forwards; }
    .hero-enso svg { width:100%; height:100%; animation:ensoSpin 50s linear infinite; }
    .hero-content { position:relative; z-index:2; padding:0 1.5rem; }
    .hero-sup { display:block; font-size:.7rem; letter-spacing:.45em; text-transform:uppercase; color:var(--gold); margin-bottom:1.75rem; opacity:0; animation:fadeInUp .9s .2s var(--ease) forwards; }
    .hero-title { font-family:var(--serif); font-size:clamp(5rem,15vw,12rem); font-weight:400; letter-spacing:.16em; line-height:1; margin-bottom:1.5rem; }
    .hero-title span {
      display:inline-block; opacity:0;
      background:linear-gradient(90deg,var(--cream) 0%,var(--gold-2) 40%,var(--cream) 60%,var(--gold-2) 80%,var(--cream) 100%);
      background-size:200% auto;
      -webkit-background-clip:text; background-clip:text;
      -webkit-text-fill-color:transparent;
      animation:letterIn .8s calc(.35s + var(--i)*.1s) var(--ease) forwards, shimmer 4s calc(1.6s + var(--i)*.12s) linear infinite;
    }
    .hero-tagline { font-size:clamp(.85rem,1.5vw,1rem); color:var(--muted); letter-spacing:.08em; margin-bottom:3rem; opacity:0; animation:fadeInUp .9s .95s var(--ease) forwards; }
    .hero-divider { width:60px; height:1px; background:var(--gold); margin:0 auto 3rem; opacity:0; animation:expandX .8s 1.1s var(--ease) forwards, fadeIn .8s 1.1s forwards; }
    .hero-actions { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; opacity:0; animation:fadeInUp .9s 1.25s var(--ease) forwards; }
    .hero-scroll { position:absolute; bottom:2.5rem; left:50%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:.5rem; opacity:0; animation:fadeIn 1s 1.6s forwards; z-index:2; }
    .hero-scroll span { font-size:.6rem; letter-spacing:.35em; text-transform:uppercase; color:var(--muted); }
    .scroll-arr { width:1px; height:36px; background:linear-gradient(180deg,var(--gold),transparent); animation:scrollBounce 2s ease-in-out infinite; }
    .dust { position:absolute; width:4px; height:4px; border-radius:50%; background:var(--gold-2); opacity:0; animation:dustFloat var(--dd) var(--dl) ease-in-out infinite; pointer-events:none; }

    /* uramaki flottanti */
    .uramaki-wrap { position:absolute; z-index:1; pointer-events:none; opacity:0; }
    .uramaki-wrap svg { display:block; border-radius:50%; filter:drop-shadow(0 4px 18px rgba(201,168,76,.22)); }
    .ur1 { width:72px; top:18%; left:5%; --ra:-8deg; --rb:6deg; animation:fadeIn .8s 1.8s forwards, floatRoll 7s 1.8s ease-in-out infinite; }
    .ur2 { width:54px; top:58%; left:3%; --ra:12deg; --rb:-4deg; animation:fadeIn .8s 2.4s forwards, floatRoll 9s 2.4s ease-in-out infinite; }
    .ur3 { width:78px; top:18%; right:5%; --ra:5deg; --rb:-10deg; animation:fadeIn .8s 1.5s forwards, floatRoll 8s 1.5s ease-in-out infinite; }
    .ur4 { width:58px; top:62%; right:3%; --ra:-6deg; --rb:8deg; animation:fadeIn .8s 3s forwards, floatRoll 6.5s 3s ease-in-out infinite; }
    @media (max-width:640px) {
      .ur1 { width:46px; top:14%; left:4%; }
      .ur2 { display:none; }
      .ur3 { width:50px; top:13%; right:4%; }
      .ur4 { width:40px; top:auto; bottom:18%; right:6%; }
    }

    /* ════════ MARQUEE ════════ */
    .marquee { overflow:hidden; border-top:1px solid var(--border); border-bottom:1px solid var(--border); background:#0C0C0C; padding:1rem 0; }
    .marquee-track { display:flex; gap:0; width:max-content; animation:marqueeX 30s linear infinite; }
    .marquee-seq { display:flex; align-items:center; gap:3rem; padding-right:3rem; white-space:nowrap; }
    .mq-jp { font-family:var(--serif); font-size:1.05rem; color:var(--gold); letter-spacing:.2em; }
    .mq-en { font-size:.7rem; letter-spacing:.4em; text-transform:uppercase; color:var(--muted); }
    .mq-dot { width:5px; height:5px; border-radius:50%; background:var(--gold); opacity:.5; flex-shrink:0; }

    /* ════════ WAVE DIVIDER ════════ */
    .wave-div { position:relative; height:70px; overflow:hidden; background:var(--bg-2); }
    .wave-layer { position:absolute; bottom:0; left:0; width:200%; height:100%; display:flex; }
    .wave-layer svg { width:50%; height:100%; flex-shrink:0; }
    .w1 { animation:waveMove 22s linear infinite; opacity:.5; }
    .w2 { animation:waveMove 14s linear infinite reverse; opacity:.3; }

    /* ════════ KOI ════════ */
    .koi { position:absolute; left:-170px; width:130px; opacity:.45; pointer-events:none; z-index:0; animation:koiSwim 19s linear infinite; }
    .koi-back { left:auto; right:-170px; animation:koiSwimBack 23s 6s linear infinite; }
    .koi svg { overflow:visible; }
    .koi-tail { animation:tailWag .55s ease-in-out infinite alternate; transform-origin:4% 50%; transform-box:fill-box; }
    .koi-fin { animation:finWag .8s ease-in-out infinite alternate; transform-origin:top center; transform-box:fill-box; }

    /* ════════ PHILOSOPHY ════════ */
    #philosophy { padding:7rem 2.5rem; background:var(--bg-2); position:relative; overflow:hidden; }
    .phil-inner { position:relative; z-index:1; max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:6rem; align-items:center; }
    .phil-art { font-family:var(--serif); font-size:clamp(6rem,12vw,10rem); font-weight:700; color:rgba(201,168,76,.15); line-height:1; text-align:center; animation:dishFloat 6s ease-in-out infinite; }
    .phil-art-lbl { text-align:center; font-size:.65rem; letter-spacing:.3em; text-transform:uppercase; color:var(--gold); margin-top:.5rem; }
    .phil-sub { max-width:100%!important; margin-bottom:1.5rem; }
    .phil-quote { border-left:2px solid var(--gold); padding:.75rem 1.25rem; font-family:var(--serif); font-size:1.05rem; color:var(--muted); font-style:italic; margin-top:2rem; }

    /* ════════ SIGNATURE — PIATTI ANIMATI ════════ */
    #signature { padding:7rem 2.5rem; background:var(--bg); position:relative; overflow:hidden; }
    .sig-hd { max-width:1100px; margin:0 auto 4rem; position:relative; z-index:1; }
    .dishes-grid { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; position:relative; z-index:1; }
    .dish-card { background:var(--bg-card); border:1px solid var(--border); overflow:hidden; cursor:pointer; transition:border-color .3s var(--ease),transform .35s var(--ease),box-shadow .35s var(--ease); }
    .dish-card:hover { border-color:rgba(201,168,76,.45); transform:translateY(-8px) scale(1.01); box-shadow:0 20px 50px rgba(0,0,0,.5),0 0 30px rgba(201,168,76,.08); }
    .dish-img { height:230px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; }
    .dish-scene { width:100%; height:100%; animation:dishFloat 5s ease-in-out infinite; }
    .dish-card:nth-child(2) .dish-scene { animation-delay:.7s; }
    .dish-card:nth-child(3) .dish-scene { animation-delay:1.3s; }
    .dish-card:nth-child(4) .dish-scene { animation-delay:.4s; }
    .dish-kanji-bg { position:absolute; font-family:var(--serif); font-size:6.5rem; font-weight:700; color:rgba(240,235,225,.04); user-select:none; pointer-events:none; }
    .dish-tag { position:absolute; top:.75rem; left:.75rem; font-size:.6rem; letter-spacing:.25em; text-transform:uppercase; color:var(--gold); background:rgba(201,168,76,.12); padding:.3rem .7rem; z-index:2; backdrop-filter:blur(4px); }
    .dish-info { padding:1.25rem; }
    .dish-name { font-family:var(--serif); font-size:1.1rem; color:var(--cream); margin-bottom:.3rem; }
    .dish-desc { font-size:.8rem; color:var(--muted); line-height:1.6; margin-bottom:.75rem; }
    .dish-price { font-size:.85rem; color:var(--gold); letter-spacing:.05em; }
    .dish-toro .dish-img   { background:radial-gradient(ellipse at 50% 80%,#241010 0%,#160808 70%); }
    .dish-uni .dish-img    { background:radial-gradient(ellipse at 50% 80%,#1a2415 0%,#0e1510 70%); }
    .dish-dragon .dish-img { background:radial-gradient(ellipse at 50% 80%,#1c2a10 0%,#0d1508 70%); }
    .dish-wagyu .dish-img  { background:radial-gradient(ellipse at 50% 80%,#2a1c08 0%,#150e05 70%); }

    /* SVG dish animations */
    .steam { animation:steamRise 3.2s ease-out infinite; transform-box:fill-box; }
    .steam.s2 { animation-delay:1.1s; }
    .steam.s3 { animation-delay:2.2s; }
    .flame { animation:flameFlick .55s ease-in-out infinite; transform-origin:bottom center; transform-box:fill-box; }
    .flame.f2 { animation-delay:.2s; animation-duration:.7s; }
    .flame.f3 { animation-delay:.35s; animation-duration:.45s; }
    .sparkle { animation:sparkleTwk 2.4s ease-in-out infinite; transform-origin:center; transform-box:fill-box; }
    .sparkle.k2 { animation-delay:.8s; }
    .sparkle.k3 { animation-delay:1.5s; }
    .ikura { animation:ikuraPulse 2s ease-in-out infinite; transform-origin:center; transform-box:fill-box; }
    .ikura.i2 { animation-delay:.5s; }
    .ikura.i3 { animation-delay:1s; }
    .sesame { animation:sesameFall 3.4s linear infinite; transform-box:fill-box; }
    .sesame.e2 { animation-delay:1.2s; }
    .sesame.e3 { animation-delay:2.3s; }
    .slice { animation:sliceBob 3.4s ease-in-out infinite; transform-box:fill-box; }
    .slice.sl2 { animation-delay:.6s; }
    .slice.sl3 { animation-delay:1.2s; }
    .ripple { animation:sojuRipple 2.6s ease-out infinite; transform-origin:center; transform-box:fill-box; }

    /* ════════ OMAKASE ════════ */
    #omakase { padding:8rem 2.5rem; background:var(--bg-2); position:relative; overflow:hidden; text-align:center; }
    .om-bg-k { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:var(--serif); font-size:40vw; font-weight:700; color:rgba(201,168,76,.02); pointer-events:none; user-select:none; line-height:1; }
    .om-lantern { position:absolute; top:0; right:6%; width:74px; transform-origin:top center; animation:lanternSwing 3.5s ease-in-out infinite alternate; z-index:1; }
    .om-lantern .lglow { animation:lanternGlow 3s ease-in-out infinite; }
    .om-lantern-l { right:auto; left:6%; animation-delay:1.2s; }
    @media (max-width:640px){ .om-lantern { width:48px; right:3%; } .om-lantern-l { left:3%; } }
    .om-inner { position:relative; z-index:2; max-width:700px; margin:0 auto; }
    .om-inner .sec-sub { max-width:100%; margin:0 auto 1.5rem; }
    .om-price { display:inline-flex; flex-direction:column; align-items:center; gap:.25rem; margin:2rem 0; padding:1.5rem 3rem; border:1px solid var(--border); transition:border-color .3s,box-shadow .3s; }
    .om-price:hover { border-color:var(--gold); box-shadow:0 0 30px rgba(201,168,76,.12); }
    .om-plabel { font-size:.65rem; letter-spacing:.35em; text-transform:uppercase; color:var(--muted); }
    .om-pval { font-family:var(--serif); font-size:2.5rem; color:var(--gold); font-weight:500; }
    .om-pnote { font-size:.75rem; color:var(--muted); }
    .om-feats { display:flex; justify-content:center; gap:3rem; margin-bottom:2.5rem; flex-wrap:wrap; }
    .om-feat { display:flex; flex-direction:column; align-items:center; gap:.5rem; }
    .om-feat-icon { width:40px; height:40px; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--gold); transition:transform .3s,border-color .3s; }
    .om-feat:hover .om-feat-icon { transform:rotate(45deg); border-color:var(--gold); }
    .om-feat:hover .om-feat-icon svg { transform:rotate(-45deg); }
    .om-feat-icon svg { width:18px; height:18px; transition:transform .3s; }
    .om-feat-txt { font-size:.72rem; letter-spacing:.08em; color:var(--muted); text-align:center; }

    /* ════════ TORII ════════ */
    #torii { padding:7rem 2.5rem 5rem; background:#060606; position:relative; overflow:hidden; text-align:center; }
    .torii-top { margin-bottom:4rem; position:relative; z-index:1; }
    .torii-top .sec-sub { max-width:520px; margin:0 auto; }
    .torii-stage { position:relative; display:flex; justify-content:center; align-items:flex-start; }
    .torii-svg { width:min(420px,82vw); height:auto; }
    .torii-path { stroke:var(--gold); stroke-linecap:square; fill:none; }
    .torii-svg.glowing .torii-path { animation:toriiGlow 2.5s ease-in-out infinite; }
    .torii-pillar-inner { stroke:rgba(201,168,76,.3); }
    .torii-kanji-base { position:absolute; bottom:-10px; left:50%; transform:translateX(-50%); font-family:var(--serif); font-size:1rem; letter-spacing:.6em; color:var(--gold); opacity:0; transition:opacity 1.2s ease; white-space:nowrap; }
    .torii-kanji-base.show { opacity:1; }
    .sakura-layer { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
    .spetal { position:absolute; top:0; width:22px; height:22px; opacity:0; animation:sakuraFall var(--dur) var(--del) linear forwards; }

    /* ════════ MENU ════════ */
    #menu { padding:7rem 2.5rem; background:var(--bg); position:relative; overflow:hidden; }
    .menu-inner { max-width:900px; margin:0 auto; position:relative; z-index:1; }
    .menu-hd { margin-bottom:3.5rem; }
    .menu-tabs { display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:3rem; }
    .menu-tab { padding:.75rem 1.75rem; background:none; border:none; color:var(--muted); font-size:.78rem; letter-spacing:.15em; text-transform:uppercase; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; transition:color .25s,border-color .25s; }
    .menu-tab.active { color:var(--gold); border-bottom-color:var(--gold); }
    .menu-tab:hover { color:var(--cream); }
    .menu-panel { display:none; }
    .menu-panel.active { display:block; }
    .menu-items { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem 3rem; }
    .menu-panel.active .menu-item { opacity:0; animation:fadeInUp .5s var(--ease) forwards; }
    .menu-panel.active .menu-item:nth-child(1){animation-delay:.05s}
    .menu-panel.active .menu-item:nth-child(2){animation-delay:.1s}
    .menu-panel.active .menu-item:nth-child(3){animation-delay:.15s}
    .menu-panel.active .menu-item:nth-child(4){animation-delay:.2s}
    .menu-panel.active .menu-item:nth-child(5){animation-delay:.25s}
    .menu-panel.active .menu-item:nth-child(6){animation-delay:.3s}
    .menu-panel.active .menu-item:nth-child(7){animation-delay:.35s}
    .menu-panel.active .menu-item:nth-child(8){animation-delay:.4s}
    .menu-item { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding-bottom:1.25rem; border-bottom:1px solid rgba(240,235,225,.05); transition:border-color .3s,transform .3s; }
    .menu-item:hover { border-bottom-color:rgba(201,168,76,.4); transform:translateX(6px); }
    .mi-name { font-family:var(--serif); font-size:1rem; color:var(--cream); margin-bottom:.2rem; }
    .mi-desc { font-size:.75rem; color:var(--muted); }
    .mi-price { font-size:.9rem; color:var(--gold); white-space:nowrap; flex-shrink:0; }

    /* ════════ RESERVATION ════════ */
    #reservation { padding:7rem 2.5rem; background:var(--bg-2); }
    .res-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:6rem; align-items:start; }
    .res-title { font-family:var(--serif); font-size:clamp(2rem,4vw,3rem); margin-bottom:1rem; }
    .res-sub { font-size:.9rem; color:var(--muted); margin-bottom:2.5rem; line-height:1.8; }
    .res-det { display:flex; flex-direction:column; gap:1rem; }
    .res-det-item { display:flex; flex-direction:column; gap:.15rem; }
    .res-det-lbl { font-size:.65rem; letter-spacing:.3em; text-transform:uppercase; color:var(--gold); }
    .res-det-val { font-size:.9rem; color:var(--cream); }
    .res-form { display:flex; flex-direction:column; gap:1.25rem; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    .form-group { display:flex; flex-direction:column; gap:.4rem; }
    .form-lbl { font-size:.65rem; letter-spacing:.25em; text-transform:uppercase; color:var(--muted); }
    .form-input,.form-sel,.form-ta { background:rgba(240,235,225,.04); border:1px solid var(--border); color:var(--cream); font-family:var(--sans); font-size:.9rem; font-weight:300; padding:.85rem 1rem; outline:none; transition:border-color .25s,background .25s,box-shadow .25s; width:100%; }
    .form-input::placeholder,.form-ta::placeholder { color:var(--muted); }
    .form-input:focus,.form-sel:focus,.form-ta:focus { border-color:var(--gold); background:rgba(201,168,76,.04); box-shadow:0 0 0 3px rgba(201,168,76,.08); }
    .form-sel { cursor:pointer; }
    .form-sel option { background:#111; color:var(--cream); }
    .form-ta { resize:vertical; min-height:100px; }
    .form-submit { width:100%; padding:1rem; margin-top:.5rem; }

    /* ════════ FOOTER ════════ */
    footer { background:#080808; border-top:1px solid var(--border); padding:4rem 2.5rem 2.5rem; }
    .foot-inner { max-width:1100px; margin:0 auto; }
    .foot-top { display:grid; grid-template-columns:2fr 1fr 1fr; gap:4rem; margin-bottom:3.5rem; }
    .foot-logo-en { font-family:var(--serif); font-size:1.6rem; letter-spacing:.2em; color:var(--cream); }
    .foot-logo-jp { font-family:var(--serif); font-size:.7rem; letter-spacing:.3em; color:var(--gold); margin:.15rem 0 1rem; }
    .foot-tag { font-size:.82rem; color:var(--muted); line-height:1.7; max-width:260px; }
    .foot-col-t { font-size:.65rem; letter-spacing:.35em; text-transform:uppercase; color:var(--gold); margin-bottom:1.25rem; }
    .foot-col ul { display:flex; flex-direction:column; gap:.75rem; }
    .foot-col a { font-size:.82rem; color:var(--muted); transition:color .25s,padding-left .25s; }
    .foot-col a:hover { color:var(--cream); padding-left:6px; }
    .foot-hrs { display:flex; flex-direction:column; gap:.6rem; }
    .foot-hr { display:flex; justify-content:space-between; font-size:.8rem; }
    .foot-hr-day { color:var(--muted); }
    .foot-hr-time { color:var(--cream); }
    .foot-bot { display:flex; justify-content:space-between; align-items:center; padding-top:2rem; border-top:1px solid rgba(240,235,225,.05); flex-wrap:wrap; gap:1rem; }
    .foot-copy { font-size:.72rem; color:var(--muted); letter-spacing:.05em; }
    .foot-addr { font-size:.72rem; color:var(--muted); text-align:right; }

    /* ════════ RESPONSIVE ════════ */
    @media (max-width:900px) {
      .dishes-grid { grid-template-columns:repeat(2,1fr); }
      .phil-inner { grid-template-columns:1fr; gap:3rem; }
      .phil-art { font-size:8rem; }
      .res-inner { grid-template-columns:1fr; gap:3rem; }
      .foot-top { grid-template-columns:1fr 1fr; gap:2.5rem; }
      .foot-brand { grid-column:1/-1; }
    }
    @media (max-width:640px) {
      .dishes-grid { grid-template-columns:1fr; }
      .nav-links { display:none; }
      .nav-burger { display:flex; }
      .menu-items { grid-template-columns:1fr; }
      .form-row { grid-template-columns:1fr; }
      .foot-top { grid-template-columns:1fr; }
      .om-feats { gap:1.5rem; }
      #navbar { padding:1.25rem 1.5rem; }
      #navbar.scrolled { padding:.85rem 1.5rem; }
      .menu-tab { padding:.75rem 1rem; font-size:.7rem; }
    }
    @media (prefers-reduced-motion:reduce) {
      *,*::before,*::after { animation-duration:.01ms!important; transition-duration:.01ms!important; }
    }

    /* ════════ FAB PRENOTA ════════ */
    .fab-prenota { position:fixed; bottom:2rem; right:2rem; z-index:150; display:inline-flex; align-items:center; gap:.6rem; padding:.85rem 1.6rem; background:var(--gold); color:#0A0A0A; font-family:var(--sans); font-size:.76rem; font-weight:500; letter-spacing:.14em; text-transform:uppercase; box-shadow:0 8px 32px rgba(201,168,76,.45),0 2px 8px rgba(0,0,0,.4); transition:background .25s var(--ease),transform .2s var(--ease),box-shadow .25s; text-decoration:none; overflow:hidden; }
    .fab-prenota::before { content:''; position:absolute; inset:0; background:rgba(255,255,255,.06); }
    .fab-prenota::after { content:''; position:absolute; top:-20%; left:0; width:40px; height:140%; background:rgba(255,255,255,.35); transform:translateX(-70px) rotate(18deg); transition:none; }
    .fab-prenota:hover { background:var(--gold-2); transform:translateY(-3px); box-shadow:0 16px 44px rgba(201,168,76,.6),0 4px 12px rgba(0,0,0,.4); }
    .fab-prenota:hover::after { animation:sheenSweep .8s var(--ease); }
    .fab-prenota svg { width:15px; height:15px; flex-shrink:0; }
    @keyframes fabPulse { 0%,100%{box-shadow:0 8px 32px rgba(201,168,76,.45),0 2px 8px rgba(0,0,0,.4)} 50%{box-shadow:0 8px 40px rgba(201,168,76,.7),0 2px 8px rgba(0,0,0,.4)} }
    .fab-prenota { animation:fabPulse 3s ease-in-out infinite; }
    .fab-prenota:hover { animation:none; }
    @media (max-width:640px){ .fab-prenota { bottom:1.25rem; right:1.25rem; padding:.7rem 1.1rem; font-size:.7rem; gap:.45rem; letter-spacing:.1em; } }

    /* ════════ PAGE TRANSITION — BACCHETTE ════════ */
    #ptOverlay { position:fixed; inset:0; z-index:300; visibility:hidden; pointer-events:none; }
    #ptOverlay.pt-active { visibility:visible; pointer-events:all; }
    .pt-panel { position:absolute; left:0; width:100%; height:50.5%; background:linear-gradient(180deg,#0B0A08,#0E0C08); transform:scaleY(0); transition:transform .42s cubic-bezier(0.4,0,0.2,1); }
    .pt-top { top:0; transform-origin:top; box-shadow:0 1px 0 rgba(201,168,76,.25); }
    .pt-bot { bottom:0; transform-origin:bottom; box-shadow:0 -1px 0 rgba(201,168,76,.25); }
    #ptOverlay.pt-closing .pt-panel,
    #ptOverlay.pt-open    .pt-panel { transform:scaleY(1); }
    #ptOverlay.pt-opening .pt-panel { transform:scaleY(0); }
    .pt-center { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:.5rem; opacity:0; transition:opacity .25s ease; }
    #ptOverlay.pt-open .pt-center { opacity:1; }
    #ptOverlay.pt-opening .pt-center { opacity:0; }
    .pt-scene { width:160px; height:210px; overflow:visible; }
    .pt-grab { transform:translateY(-210px); transition:transform 1.4s cubic-bezier(0.4,0,0.2,1); }
    #ptOverlay.pt-open .pt-grab { transform:translateY(0); }
    #ptOverlay.pt-open .pt-nigiri { transform:translateY(0); }
    .pt-lift .pt-grab, .pt-lift .pt-nigiri { transform:translateY(-260px) rotate(-4deg) !important; transition:transform .6s cubic-bezier(0.4,0,1,1) !important; }
    .pt-stick-l { transform:rotate(-5deg); transition:transform .25s ease; transform-box:fill-box; transform-origin:top center; }
    .pt-stick-r { transform:rotate(5deg); transition:transform .25s ease; transform-box:fill-box; transform-origin:top center; }
    #ptOverlay.pt-open .pt-stick-l { transform:rotate(0deg); }
    #ptOverlay.pt-open .pt-stick-r { transform:rotate(0deg); }
    .pt-shadow { transition:opacity .6s, transform .6s; transform-box:fill-box; transform-origin:center; }
    .pt-lift .pt-shadow { opacity:0 !important; transform:scaleX(.4) !important; }
    .pt-label { font-family:var(--serif); font-size:1rem; letter-spacing:.55em; color:var(--gold); text-indent:.55em; }
    .pt-label-jp { font-family:var(--serif); font-size:.75rem; letter-spacing:.4em; color:var(--muted); text-indent:.4em; }

    /* ════════ FLOATING FOOD ════════ */
    .ffood { position:absolute; pointer-events:none; z-index:0; opacity:.8; animation:floatRoll var(--fd,8s) ease-in-out infinite; }
    .ffood svg { display:block; width:100%; height:auto; filter:drop-shadow(0 5px 16px rgba(0,0,0,.45)); }
    #reservation { position:relative; overflow:hidden; }
    @media (max-width:640px) {
      .ffood { opacity:.5; }
      .ffood.hide-m { display:none; }
    }
  </style>
</head>


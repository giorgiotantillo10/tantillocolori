<script is:inline>
// ── Progress bar + navbar + parallax
const nb = document.getElementById('navbar');
const hk = document.getElementById('heroKanji');
const pg = document.getElementById('progress');
window.addEventListener('scroll', () => {
  nb.classList.toggle('scrolled', scrollY > 50);
  if(hk) hk.style.transform = `translate(-50%,calc(-50% + ${scrollY * 0.15}px))`;
  const max = document.documentElement.scrollHeight - innerHeight;
  if(pg && max > 0) pg.style.width = (scrollY / max * 100) + '%';
}, {passive:true});

// ── Mobile menu
const burger = document.getElementById('navBurger');
const mob = document.getElementById('navMobile');
burger.addEventListener('click', () => mob.classList.add('open'));
document.getElementById('navClose').addEventListener('click', () => mob.classList.remove('open'));
function closeMob() { mob.classList.remove('open'); }

// ── Scroll animations
const obs = new IntersectionObserver(entries => {
  entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('in'); obs.unobserve(e.target); } });
}, {threshold:0.12});
document.querySelectorAll('.anim').forEach(el => obs.observe(el));

// ── Page transition: bacchette che afferrano il nigiri
(function(){
  const ov = document.getElementById('ptOverlay');
  if(!ov) return;
  const ptReduce = matchMedia('(prefers-reduced-motion:reduce)').matches;
  let busy = false;
  const cl = ov.classList;

  function jumpTo(target){
    const html = document.documentElement;
    const prev = html.style.scrollBehavior;
    html.style.scrollBehavior = 'auto';
    if(target === document.body) scrollTo(0,0);
    else target.scrollIntoView();
    html.style.scrollBehavior = prev;
  }

  function runTransition(target){
    if(busy) return;
    busy = true;
    // fase 1 — chiudi sipario (pannelli scendono, 0-420ms)
    cl.add('pt-active','pt-closing');
    // fase 2 — mostra bacchette + nigiri (420ms)
    setTimeout(() => {
      cl.remove('pt-closing');
      cl.add('pt-open');
    }, 430);
    // fase 3 — salta alla sezione (sipario già chiuso, 700ms)
    setTimeout(() => jumpTo(target), 700);
    // fase 4 — solleva nigiri (1300ms)
    setTimeout(() => cl.add('pt-lift'), 1300);
    // fase 5 — apri sipario (1700ms, transition 420ms)
    setTimeout(() => {
      cl.remove('pt-open','pt-lift');
      cl.add('pt-opening');
    }, 1700);
    // fase 6 — ripristina tutto (2200ms)
    setTimeout(() => {
      cl.remove('pt-active','pt-opening');
      busy = false;
    }, 2200);
  }

  document.querySelectorAll('a[href^="#"]').forEach(a => {
    a.addEventListener('click', e => {
      const href = a.getAttribute('href');
      const target = href === '#' ? document.body : document.querySelector(href);
      if(!target) return;
      e.preventDefault();
      if(typeof mob !== 'undefined') mob.classList.remove('open');
      if(ptReduce){ jumpTo(target); return; }
      runTransition(target);
    });
  });
})();

// ── Menu tabs
document.querySelectorAll('.menu-tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.menu-tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.menu-panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
  });
});

// ── Form
function handleSub(e) {
  e.preventDefault();
  const btn = e.target.querySelector('.form-submit');
  btn.textContent = 'Prenotazione Inviata ✓';
  btn.style.background = '#4a7c59';
  btn.disabled = true;
}
const di = document.getElementById('fd');
if(di){ const t = new Date(); t.setDate(t.getDate()+1); di.min = t.toISOString().split('T')[0]; }

// ── TORII draw animation
(function(){
  const paths = document.querySelectorAll('.torii-path');
  const svg = document.getElementById('toriiSvg');
  const label = document.getElementById('toriiLabel');
  paths.forEach(p => {
    try {
      const len = p.getTotalLength ? p.getTotalLength() : 800;
      p.style.strokeDasharray = len;
      p.style.strokeDashoffset = len;
    } catch(err) {
      p.style.strokeDasharray = 800;
      p.style.strokeDashoffset = 800;
    }
  });
  let drawn = false;
  const tObs = new IntersectionObserver(([entry]) => {
    if(entry.isIntersecting && !drawn){
      drawn = true;
      const order = ['tpKasagi','tpCapL','tpCapR','tpNuki','tpPilL','tpPilR','tpDL','tpDR'];
      order.forEach((id, i) => {
        const el = document.getElementById(id);
        if(!el) return;
        setTimeout(() => {
          el.style.transition = `stroke-dashoffset ${id.startsWith('tpPil') ? 1000 : 700}ms cubic-bezier(0.4,0,0.2,1)`;
          el.style.strokeDashoffset = '0';
        }, i * 280);
      });
      setTimeout(() => {
        svg.classList.add('glowing');
        label.classList.add('show');
        spawnSakura();
      }, order.length * 280 + 1100);
      tObs.disconnect();
    }
  }, {threshold:0.35});
  const sec = document.getElementById('torii');
  if(sec) tObs.observe(sec);

  function spawnSakura(){
    const layer = document.getElementById('sakuraLayer');
    if(!layer) return;
    const colors = ['#FFB7C5','#FFCCD5','#FFA0B4','#FFD6E0','#E8A0B0'];
    for(let i = 0; i < 22; i++){
      const p = document.createElement('div');
      p.className = 'spetal';
      const dur = (3.5 + Math.random() * 4.5).toFixed(1) + 's';
      const del = (Math.random() * 3.5).toFixed(1) + 's';
      const left = (Math.random() * 92 + 2).toFixed(1) + '%';
      const drift = ((Math.random() - 0.5) * 120).toFixed(0) + 'px';
      const col = colors[Math.floor(Math.random() * colors.length)];
      const rot = Math.floor(Math.random() * 360);
      p.style.cssText = `left:${left};--dur:${dur};--del:${del};--drift:${drift};`;
      p.innerHTML = `<svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg" style="transform:rotate(${rot}deg)">
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(0 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(72 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(144 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(216 20 20)"/>
        <ellipse cx="20" cy="10" rx="6" ry="10" fill="${col}" opacity=".85" transform="rotate(288 20 20)"/>
        <circle cx="20" cy="20" r="3" fill="${col}"/>
      </svg>`;
      layer.appendChild(p);
    }
    setTimeout(spawnSakura, 5000);
  }
})();
</script>


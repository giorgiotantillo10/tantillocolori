---
// Osaki — Japanese Sushi Restaurant
---

<!doctype html>
<html lang="it">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="favicon.svg" />
  <title>Osaki — Ristorante Giapponese di Sushi</title>
  <meta name="description" content="Un'autentica esperienza di sushi giapponese a Milano. Omakase, ingredienti stagionali freschi, atmosfera esclusiva." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@300;400;500;700&family=Noto+Serif+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style is:inline>
    :root {
      --bg:       #0A0A0A;
      --bg-2:     #111111;
      --bg-card:  #141414;
      --gold:     #C9A84C;
      --gold-2:   #E3C47A;
      --gold-dim: rgba(201,168,76,0.12);
      --cream:    #F0EBE1;
      --muted:    #7A6D5E;
      --border:   rgba(201,168,76,0.15);
      --serif:    'Noto Serif JP', serif;
      --sans:     'Noto Sans JP', sans-serif;
      --ease:     cubic-bezier(0.4,0,0.2,1);
    }
    *,*::before,*::after { margin:0; padding:0; box-sizing:border-box; }
    html { scroll-behavior:smooth; }
    body { background:var(--bg); color:var(--cream); font-family:var(--sans); font-weight:300; line-height:1.75; overflow-x:hidden; }
    h1,h2,h3,h4 { font-family:var(--serif); font-weight:500; }
    a { color:inherit; text-decoration:none; }
    ul { list-style:none; }
    button { cursor:pointer; font-family:var(--sans); }

    /* ── KEYFRAMES ───────────────────────────────── */
    @keyframes fadeInUp  { from{opacity:0;transform:translateY(28px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fadeIn    { from{opacity:0} to{opacity:1} }
    @keyframes expandX   { from{transform:scaleX(0)} to{transform:scaleX(1)} }
    @keyframes scrollBounce { 0%,100%{transform:translateY(0);opacity:1} 50%{transform:translateY(8px);opacity:.4} }

    /* Uramaki float + rotate */
    @keyframes floatRoll {
      0%,100% { transform:translateY(0) rotate(var(--ra)); }
      50%      { transform:translateY(-18px) rotate(var(--rb)); }
    }
    @keyframes spinSlow { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }

    /* Sakura fall */
    @keyframes sakuraFall {
      0%   { transform:translateY(-60px) rotate(0deg) translateX(0); opacity:1; }
      80%  { opacity:.8; }
      100% { transform:translateY(680px) rotate(720deg) translateX(var(--drift)); opacity:0; }
    }

    /* Torii glow pulse after draw */
    @keyframes toriiGlow {
      0%,100% { filter:drop-shadow(0 0 6px rgba(201,168,76,.35)); }
      50%      { filter:drop-shadow(0 0 22px rgba(201,168,76,.8)); }
    }

    /* Text shimmer */
    @keyframes shimmer {
      0%   { background-position:200% center; }
      100% { background-position:-200% center; }
    }

    /* ── SCROLL ANIMATION BASE ───────────────────── */
    .anim { opacity:0; transform:translateY(32px); transition:opacity .7s var(--ease),transform .7s var(--ease); }
    .anim.in { opacity:1; transform:none; }
    .d1 { transition-delay:.1s; }
    .d2 { transition-delay:.2s; }
    .d3 { transition-delay:.3s; }
    .d4 { transition-delay:.4s; }
    .d5 { transition-delay:.5s; }

    /* ── UTILITIES ───────────────────────────────── */
    .lbl { display:inline-flex; align-items:center; gap:.75rem; font-size:.7rem; letter-spacing:.35em; text-transform:uppercase; color:var(--gold); margin-bottom:1.25rem; }
    .lbl::before { content:''; display:block; width:32px; height:1px; background:var(--gold); }
    .sec-title { font-size:clamp(2rem,4vw,3rem); color:var(--cream); line-height:1.2; margin-bottom:1.25rem; }
    .sec-sub { font-size:.95rem; color:var(--muted); max-width:520px; line-height:1.8; }
    .btn-p { display:inline-flex; align-items:center; gap:.5rem; padding:.85rem 2rem; background:var(--gold); color:#0A0A0A; font-family:var(--sans); font-size:.8rem; font-weight:500; letter-spacing:.12em; text-transform:uppercase; border:none; transition:background .25s var(--ease),transform .2s var(--ease); cursor:pointer; }
    .btn-p:hover { background:var(--gold-2); transform:translateY(-2px); }
    .btn-s { display:inline-flex; align-items:center; gap:.5rem; padding:.85rem 2rem; background:transparent; color:var(--cream); font-family:var(--sans); font-size:.8rem; font-weight:400; letter-spacing:.12em; text-transform:uppercase; border:1px solid rgba(240,235,225,.25); transition:border-color .25s var(--ease),color .25s var(--ease),transform .2s var(--ease); cursor:pointer; }
    .btn-s:hover { border-color:var(--gold); color:var(--gold); transform:translateY(-2px); }

    /* ── NAVBAR ──────────────────────────────────── */
    #navbar { position:fixed; top:0; left:0; right:0; z-index:100; padding:1.5rem 2.5rem; transition:background .4s var(--ease),padding .4s var(--ease),box-shadow .4s var(--ease); }
    #navbar.scrolled { background:rgba(10,10,10,.93); backdrop-filter:blur(18px); -webkit-backdrop-filter:blur(18px); padding:1rem 2.5rem; box-shadow:0 1px 0 var(--border); }
    .nav-inner { max-width:1200px; margin:0 auto; display:flex; align-items:center; justify-content:space-between; }
    .nav-logo { display:flex; flex-direction:column; line-height:1; cursor:pointer; }
    .logo-en { font-family:var(--serif); font-size:1.4rem; font-weight:600; letter-spacing:.2em; color:var(--cream); }
    .logo-jp { font-family:var(--serif); font-size:.65rem; letter-spacing:.3em; color:var(--gold); margin-top:2px; }
    .nav-links { display:flex; align-items:center; gap:2.5rem; }
    .nav-links a { font-size:.78rem; letter-spacing:.12em; text-transform:uppercase; color:var(--muted); transition:color .25s; }
    .nav-links a:hover { color:var(--cream); }
    .nav-reserve { font-size:.78rem!important; letter-spacing:.12em!important; text-transform:uppercase!important; padding:.6rem 1.4rem!important; border:1px solid var(--gold)!important; color:var(--gold)!important; transition:background .25s,color .25s!important; }
    .nav-reserve:hover { background:var(--gold)!important; color:#0A0A0A!important; }
    .nav-burger { display:none; flex-direction:column; gap:5px; background:none; border:none; padding:.25rem; }
    .nav-burger span { display:block; width:22px; height:1px; background:var(--cream); transition:transform .3s,opacity .3s; }
    .nav-mobile { display:none; position:fixed; inset:0; background:rgba(10,10,10,.98); z-index:99; flex-direction:column; align-items:center; justify-content:center; gap:2.5rem; }
    .nav-mobile.open { display:flex; }
    .nav-mobile a { font-family:var(--serif); font-size:1.8rem; color:var(--cream); letter-spacing:.1em; }
    .nav-mobile a:hover { color:var(--gold); }
    .nav-mc { position:absolute; top:1.5rem; right:2rem; background:none; border:none; color:var(--muted); font-size:1.5rem; line-height:1; }

    /* ── HERO ────────────────────────────────────── */
    #hero { height:100vh; min-height:600px; position:relative; display:flex; align-items:center; justify-content:center; text-align:center; overflow:hidden; }
    .hero-bg { position:absolute; inset:0; background:radial-gradient(ellipse 90% 60% at 50% 40%,rgba(201,168,76,.055) 0%,transparent 70%),linear-gradient(180deg,#0A0A0A 0%,#0E0D0B 100%); }
    .hero-kanji { position:absolute; font-family:var(--serif); font-size:min(55vw,52vh); font-weight:700; color:rgba(201,168,76,.025); user-select:none; pointer-events:none; line-height:1; top:50%; left:50%; transform:translate(-50%,-50%); will-change:transform; }
    .hero-lines { position:absolute; inset:0; overflow:hidden; pointer-events:none; }
    .hero-lh { position:absolute; left:0; right:0; height:1px; background:linear-gradient(90deg,transparent,rgba(201,168,76,.07),transparent); }
    .hero-lh:nth-child(1) { top:25%; }
    .hero-lh:nth-child(2) { top:75%; }
    .hero-content { position:relative; z-index:2; padding:0 1.5rem; }
    .hero-sup { display:block; font-size:.7rem; letter-spacing:.45em; text-transform:uppercase; color:var(--gold); margin-bottom:1.75rem; opacity:0; animation:fadeInUp .9s .2s var(--ease) forwards; }
    .hero-title {
      font-family:var(--serif); font-size:clamp(5.5rem,16vw,13rem); font-weight:400; letter-spacing:.18em; line-height:1; margin-bottom:1.5rem; opacity:0;
      animation:fadeInUp .9s .45s var(--ease) forwards;
      background:linear-gradient(90deg,var(--cream) 0%,var(--gold-2) 40%,var(--cream) 60%,var(--gold-2) 80%,var(--cream) 100%);
      background-size:200% auto;
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
      background-clip:text;
    }
    .hero-title.shimmer { animation:fadeInUp .9s .45s var(--ease) forwards, shimmer 4s 1.5s linear infinite; }
    .hero-tagline { font-size:clamp(.85rem,1.5vw,1rem); font-weight:300; color:var(--muted); letter-spacing:.08em; margin-bottom:3rem; opacity:0; animation:fadeInUp .9s .65s var(--ease) forwards; }
    .hero-divider { width:60px; height:1px; background:var(--gold); margin:0 auto 3rem; transform-origin:center; opacity:0; animation:expandX .8s .85s var(--ease) forwards, fadeIn .8s .85s forwards; }
    .hero-actions { display:flex; gap:1rem; justify-content:center; flex-wrap:wrap; opacity:0; animation:fadeInUp .9s 1s var(--ease) forwards; }
    .hero-scroll { position:absolute; bottom:2.5rem; left:50%; transform:translateX(-50%); display:flex; flex-direction:column; align-items:center; gap:.5rem; opacity:0; animation:fadeIn 1s 1.4s var(--ease) forwards; }
    .hero-scroll span { font-size:.6rem; letter-spacing:.35em; text-transform:uppercase; color:var(--muted); }
    .scroll-arr { width:1px; height:36px; background:linear-gradient(180deg,var(--gold),transparent); animation:scrollBounce 2s ease-in-out infinite; }

    /* ── URAMAKI FLOATING ────────────────────────── */
    .uramaki-wrap {
      position:absolute; z-index:1; pointer-events:none;
      opacity:0; animation:fadeIn .8s forwards;
    }
    .uramaki-wrap svg { display:block; border-radius:50%; filter:drop-shadow(0 4px 18px rgba(201,168,76,.22)); }
    .ur1 { width:72px; top:18%; left:5%; --ra:-8deg; --rb:6deg; animation:fadeIn .8s 1.8s forwards, floatRoll 7s 1.8s ease-in-out infinite; }
    .ur2 { width:54px; top:58%; left:3%; --ra:12deg; --rb:-4deg; animation:fadeIn .8s 2.4s forwards, floatRoll 9s 2.4s ease-in-out infinite; }
    .ur3 { width:78px; top:18%; right:5%; --ra:5deg; --rb:-10deg; animation:fadeIn .8s 1.5s forwards, floatRoll 8s 1.5s ease-in-out infinite; }
    .ur4 { width:58px; top:62%; right:3%; --ra:-6deg; --rb:8deg; animation:fadeIn .8s 3s forwards, floatRoll 6.5s 3s ease-in-out infinite; }
    .ur5 { width:46px; bottom:14%; left:47%; --ra:10deg; --rb:-5deg; animation:fadeIn .8s 2.8s forwards, floatRoll 11s 2.8s ease-in-out infinite; }
    @media (max-width:640px) { .uramaki-wrap { display:none; } }

    /* ── PHILOSOPHY ──────────────────────────────── */
    #philosophy { padding:7rem 2.5rem; background:var(--bg-2); position:relative; overflow:hidden; }
    .phil-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:6rem; align-items:center; }
    .phil-art { font-family:var(--serif); font-size:clamp(6rem,12vw,10rem); font-weight:700; color:rgba(201,168,76,.15); line-height:1; text-align:center; will-change:transform; }
    .phil-art-lbl { text-align:center; font-size:.65rem; letter-spacing:.3em; text-transform:uppercase; color:var(--gold); margin-top:.5rem; }
    .phil-sub { max-width:100%!important; margin-bottom:1.5rem; }
    .phil-quote { border-left:2px solid var(--gold); padding:.75rem 1.25rem; font-family:var(--serif); font-size:1.05rem; color:var(--muted); font-style:italic; margin-top:2rem; }

    /* ── SIGNATURE DISHES ───────────────────────── */
    #signature { padding:7rem 2.5rem; background:var(--bg); }
    .sig-hd { max-width:1100px; margin:0 auto 4rem; }
    .dishes-grid { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:repeat(4,1fr); gap:1.5rem; }
    .dish-card { background:var(--bg-card); border:1px solid var(--border); overflow:hidden; cursor:pointer; transition:border-color .3s var(--ease),transform .35s var(--ease),box-shadow .35s var(--ease); }
    .dish-card:hover { border-color:rgba(201,168,76,.45); transform:translateY(-8px); box-shadow:0 20px 50px rgba(0,0,0,.5),0 0 30px rgba(201,168,76,.07); }
    .dish-img { height:220px; position:relative; overflow:hidden; display:flex; align-items:center; justify-content:center; }
    .dish-kanji { font-family:var(--serif); font-size:5rem; font-weight:700; color:rgba(240,235,225,.055); transition:color .35s var(--ease),transform .35s var(--ease); user-select:none; }
    .dish-card:hover .dish-kanji { color:rgba(201,168,76,.14); transform:scale(1.08); }
    .dish-tag { position:absolute; top:.75rem; left:.75rem; font-size:.6rem; letter-spacing:.25em; text-transform:uppercase; color:var(--gold); background:rgba(201,168,76,.1); padding:.3rem .7rem; }
    .dish-info { padding:1.25rem; }
    .dish-name { font-family:var(--serif); font-size:1.1rem; color:var(--cream); margin-bottom:.3rem; }
    .dish-desc { font-size:.8rem; color:var(--muted); line-height:1.6; margin-bottom:.75rem; }
    .dish-price { font-size:.85rem; color:var(--gold); letter-spacing:.05em; }
    .dish-toro .dish-img   { background:linear-gradient(135deg,#160808,#2d1010,#180a0a); }
    .dish-uni .dish-img    { background:linear-gradient(135deg,#0e1510,#1a2f1a,#0c1a0e); }
    .dish-dragon .dish-img { background:linear-gradient(135deg,#0d1508,#1e3014,#0c1a08); }
    .dish-wagyu .dish-img  { background:linear-gradient(135deg,#150e05,#2e200a,#180e06); }

    /* ── OMAKASE ─────────────────────────────────── */
    #omakase { padding:8rem 2.5rem; background:var(--bg-2); position:relative; overflow:hidden; text-align:center; }
    .om-bg-k { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-family:var(--serif); font-size:40vw; font-weight:700; color:rgba(201,168,76,.02); pointer-events:none; user-select:none; line-height:1; }
    .om-inner { position:relative; z-index:1; max-width:700px; margin:0 auto; }
    .om-inner .sec-sub { max-width:100%; margin:0 auto 1.5rem; }
    .om-price { display:inline-flex; flex-direction:column; align-items:center; gap:.25rem; margin:2rem 0; padding:1.5rem 3rem; border:1px solid var(--border); }
    .om-plabel { font-size:.65rem; letter-spacing:.35em; text-transform:uppercase; color:var(--muted); }
    .om-pval   { font-family:var(--serif); font-size:2.5rem; color:var(--gold); font-weight:500; }
    .om-pnote  { font-size:.75rem; color:var(--muted); }
    .om-feats { display:flex; justify-content:center; gap:3rem; margin-bottom:2.5rem; flex-wrap:wrap; }
    .om-feat { display:flex; flex-direction:column; align-items:center; gap:.5rem; }
    .om-feat-icon { width:40px; height:40px; border:1px solid var(--border); display:flex; align-items:center; justify-content:center; color:var(--gold); }
    .om-feat-icon svg { width:18px; height:18px; }
    .om-feat-txt { font-size:.72rem; letter-spacing:.08em; color:var(--muted); text-align:center; }

    /* ── TORII GATE ──────────────────────────────── */
    #torii { padding:7rem 2.5rem 5rem; background:#060606; position:relative; overflow:hidden; text-align:center; }
    .torii-top { margin-bottom:4rem; }
    .torii-top .sec-sub { max-width:520px; margin:0 auto; }
    .torii-stage { position:relative; display:flex; justify-content:center; align-items:flex-start; }
    .torii-svg { width:min(420px,82vw); height:auto; }
    .torii-path { stroke:var(--gold); stroke-linecap:square; fill:none; }
    .torii-svg.glowing .torii-path { animation:toriiGlow 2.5s ease-in-out infinite; }

    /* pillars get extra vertical line inside */
    .torii-pillar-inner { stroke:rgba(201,168,76,.3); }

    .torii-kanji-base {
      position:absolute; bottom:-10px; left:50%; transform:translateX(-50%);
      font-family:var(--serif); font-size:1rem; letter-spacing:.6em;
      color:var(--gold); opacity:0; transition:opacity 1.2s ease;
      white-space:nowrap;
    }
    .torii-kanji-base.show { opacity:1; }

    /* sakura container */
    .sakura-layer { position:absolute; inset:0; pointer-events:none; overflow:hidden; }
    .spetal { position:absolute; top:0; width:22px; height:22px; opacity:0; animation:sakuraFall var(--dur) var(--del) linear forwards; }

    /* ── MENU ────────────────────────────────────── */
    #menu { padding:7rem 2.5rem; background:var(--bg); }
    .menu-inner { max-width:900px; margin:0 auto; }
    .menu-hd { margin-bottom:3.5rem; }
    .menu-tabs { display:flex; gap:0; border-bottom:1px solid var(--border); margin-bottom:3rem; }
    .menu-tab { padding:.75rem 1.75rem; background:none; border:none; color:var(--muted); font-family:var(--sans); font-size:.78rem; letter-spacing:.15em; text-transform:uppercase; cursor:pointer; border-bottom:2px solid transparent; margin-bottom:-1px; transition:color .25s,border-color .25s; }
    .menu-tab.active { color:var(--gold); border-bottom-color:var(--gold); }
    .menu-tab:hover { color:var(--cream); }
    .menu-panel { display:none; }
    .menu-panel.active { display:block; }
    .menu-items { display:grid; grid-template-columns:1fr 1fr; gap:1.5rem 3rem; }
    .menu-item { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; padding-bottom:1.25rem; border-bottom:1px solid rgba(240,235,225,.05); }
    .mi-name { font-family:var(--serif); font-size:1rem; color:var(--cream); margin-bottom:.2rem; }
    .mi-desc { font-size:.75rem; color:var(--muted); }
    .mi-price { font-size:.9rem; color:var(--gold); white-space:nowrap; flex-shrink:0; }

    /* ── RESERVATION ─────────────────────────────── */
    #reservation { padding:7rem 2.5rem; background:var(--bg-2); }
    .res-inner { max-width:1100px; margin:0 auto; display:grid; grid-template-columns:1fr 1fr; gap:6rem; align-items:start; }
    .res-title { font-family:var(--serif); font-size:clamp(2rem,4vw,3rem); margin-bottom:1rem; }
    .res-sub { font-size:.9rem; color:var(--muted); margin-bottom:2.5rem; line-height:1.8; }
    .res-det { display:flex; flex-direction:column; gap:1rem; }
    .res-det-item { display:flex; flex-direction:column; gap:.15rem; }
    .res-det-lbl { font-size:.65rem; letter-spacing:.3em; text-transform:uppercase; color:var(--gold); }
    .res-det-val { font-size:.9rem; color:var(--cream); }
    .res-form { display:flex; flex-direction:column; gap:1.25rem; }
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    .form-group { display:flex; flex-direction:column; gap:.4rem; }
    .form-lbl { font-size:.65rem; letter-spacing:.25em; text-transform:uppercase; color:var(--muted); }
    .form-input,.form-sel,.form-ta { background:rgba(240,235,225,.04); border:1px solid var(--border); color:var(--cream); font-family:var(--sans); font-size:.9rem; font-weight:300; padding:.85rem 1rem; outline:none; transition:border-color .25s,background .25s; width:100%; }
    .form-input::placeholder,.form-ta::placeholder { color:var(--muted); }
    .form-input:focus,.form-sel:focus,.form-ta:focus { border-color:var(--gold); background:rgba(201,168,76,.04); }
    .form-sel { cursor:pointer; }
    .form-sel option { background:#111; color:var(--cream); }
    .form-ta { resize:vertical; min-height:100px; }
    .form-submit { width:100%; padding:1rem; margin-top:.5rem; }

    /* ── FOOTER ──────────────────────────────────── */
    footer { background:#080808; border-top:1px solid var(--border); padding:4rem 2.5rem 2.5rem; }
    .foot-inner { max-width:1100px; margin:0 auto; }
    .foot-top { display:grid; grid-template-columns:2fr 1fr 1fr; gap:4rem; margin-bottom:3.5rem; }
    .foot-logo-en { font-family:var(--serif); font-size:1.6rem; letter-spacing:.2em; color:var(--cream); }
    .foot-logo-jp { font-family:var(--serif); font-size:.7rem; letter-spacing:.3em; color:var(--gold); margin:.15rem 0 1rem; }
    .foot-tag { font-size:.82rem; color:var(--muted); line-height:1.7; max-width:260px; }
    .foot-col-t { font-size:.65rem; letter-spacing:.35em; text-transform:uppercase; color:var(--gold); margin-bottom:1.25rem; }
    .foot-col ul { display:flex; flex-direction:column; gap:.75rem; }
    .foot-col a { font-size:.82rem; color:var(--muted); transition:color .25s; }
    .foot-col a:hover { color:var(--cream); }
    .foot-hrs { display:flex; flex-direction:column; gap:.6rem; }
    .foot-hr { display:flex; justify-content:space-between; font-size:.8rem; }
    .foot-hr-day { color:var(--muted); }
    .foot-hr-time { color:var(--cream); }
    .foot-bot { display:flex; justify-content:space-between; align-items:center; padding-top:2rem; border-top:1px solid rgba(240,235,225,.05); flex-wrap:wrap; gap:1rem; }
    .foot-copy { font-size:.72rem; color:var(--muted); letter-spacing:.05em; }
    .foot-addr { font-size:.72rem; color:var(--muted); text-align:right; }

    /* ── RESPONSIVE ──────────────────────────────── */
    @media (max-width:900px) {
      .dishes-grid { grid-template-columns:repeat(2,1fr); }
      .phil-inner { grid-template-columns:1fr; gap:3rem; }
      .phil-art { font-size:8rem; }
      .res-inner { grid-template-columns:1fr; gap:3rem; }
      .foot-top { grid-template-columns:1fr 1fr; gap:2.5rem; }
      .foot-brand { grid-column:1/-1; }
    }
